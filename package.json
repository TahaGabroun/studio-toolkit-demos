{
  "name": "studio-toolkit-demos",
  "version": "0.2.0",
  "private": true,
  "description": "Reproducible Studio Toolkit video examples with narration-driven diagrams",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
